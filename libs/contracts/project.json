{
  "name": "contracts",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/contracts",
  "targets": {
    "compile": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "npx hardhat compile",
          "cp ../artifacts/core/AssetVault.sol/AssetVault.json ../abi/src/generated/AssetVault.json",
          "cp ../artifacts/core/AssetShares.sol/AssetShares.json ../abi/src/generated/AssetShares.json",
          "cp ../artifacts/periphery/OracleRouter.sol/OracleRouter.json ../abi/src/generated/OracleRouter.json",
          "cp ../artifacts/core/AssetUserAllowList.sol/AssetUserAllowList.json ../abi/src/generated/AssetUserAllowList.json"
        ],
        "cwd": "libs/contracts",
        "parallel": false
      },
      "configurations": {}
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx hardhat test",
        "cwd": "libs/contracts"
      }
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx hardhat test ../tests/unit/*.t.ts",
        "cwd": "libs/contracts"
      }
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx hardhat test ../tests/integration/*.t.ts",
        "cwd": "libs/contracts"
      }
    },
    "test:gas": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx hardhat test ../tests/gas/*.t.ts",
        "cwd": "libs/contracts"
      }
    },
    "test:security": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx hardhat test ../tests/security/*.t.ts",
        "cwd": "libs/contracts"
      }
    },
    "test:invariant": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx hardhat test ../tests/invariant/*.t.ts",
        "cwd": "libs/contracts"
      }
    },
    "test:upgrade": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx hardhat test ../tests/upgrade/*.t.ts",
        "cwd": "libs/contracts"
      }
    },
    "node": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx hardhat node",
        "cwd": "libs/contracts"
      }
    },
    "deploy:localhost": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx hardhat run ../scripts/deploy.ts --network localhost",
        "cwd": "libs/contracts"
      }
    },
    "seed-users": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx hardhat run ../scripts/seed-users.ts --network localhost",
        "cwd": "libs/contracts"
      }
    },
    "seed-assets": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx hardhat run ../scripts/seed-assets.ts --network localhost",
        "cwd": "libs/contracts"
      }
    }
  },
  "tags": ["scope:contracts"]
}
