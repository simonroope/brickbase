# Copy to .env.production (gitignored) after terraform apply.
#
# IMAGE_ACC=<terraform output -raw ecr_registry_id>
# EXECUTION_ROLE_ARN=<terraform output -raw ecs_execution_role_arn>
# TASK_ROLE_ARN=<terraform output -raw ecs_task_role_arn>
# REDIS_URL=<terraform output -raw redis_url>
# APP_URL=<terraform output -raw production_url>
# SSM_INFURA_ARN=arn:aws:ssm:eu-west-2:ACCOUNT_ID:parameter/brickbase/production/infura/project_id
#
# Chain / RPC (production = mainnet)
# CHAIN_ID=1
# ETHEREUM_RPC_URL=https://mainnet.infura.io/v3/<key>
#
# Contract addresses (set after deploying contracts to mainnet)
# ASSET_VAULT_ADDRESS=0x...
# ASSET_SHARES_ADDRESS=0x...
# ORACLE_ROUTER_ADDRESS=0x...
# USER_ALLOWLIST_ADDRESS=0x...
# USDC_ADDRESS=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48
#
# IMAGE_TAG is passed by CI per deploy.

ENVIRONMENT=production
SSM_PREFIX=/brickbase/production
AWS_REGION=eu-west-2
CLUSTER=brickbase-uk-production
