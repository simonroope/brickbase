# syntax=docker/dockerfile:1
FROM node:24-alpine
WORKDIR /app
COPY apps/events/package.json apps/events/package-lock.json ./apps/events/
RUN npm ci --prefix apps/events
COPY apps/events ./apps/events
WORKDIR /app/apps/events
ENV NODE_ENV=production
ENV GATEWAY_PORT=8081
EXPOSE 8081
CMD ["npx", "tsx", "gateway/src/index.ts"]
