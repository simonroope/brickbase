# syntax=docker/dockerfile:1
FROM node:20-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/
RUN npm ci

FROM node:20-alpine AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
ARG NEXT_PUBLIC_APP_URL
ARG NEXT_PUBLIC_CHAIN_ID
ARG NEXT_PUBLIC_RPC_URL
ARG NEXT_PUBLIC_ASSET_VAULT_ADDRESS
ARG NEXT_PUBLIC_ASSET_SHARES_ADDRESS
ARG NEXT_PUBLIC_ORACLE_ROUTER_ADDRESS
ARG NEXT_PUBLIC_USER_ALLOWLIST_ADDRESS
ARG NEXT_PUBLIC_USDC_ADDRESS
ARG NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID
ARG NEXT_PUBLIC_WS_LIVE_URL
ENV NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL \
    NEXT_PUBLIC_CHAIN_ID=$NEXT_PUBLIC_CHAIN_ID \
    NEXT_PUBLIC_RPC_URL=$NEXT_PUBLIC_RPC_URL \
    NEXT_PUBLIC_ASSET_VAULT_ADDRESS=$NEXT_PUBLIC_ASSET_VAULT_ADDRESS \
    NEXT_PUBLIC_ASSET_SHARES_ADDRESS=$NEXT_PUBLIC_ASSET_SHARES_ADDRESS \
    NEXT_PUBLIC_ORACLE_ROUTER_ADDRESS=$NEXT_PUBLIC_ORACLE_ROUTER_ADDRESS \
    NEXT_PUBLIC_USER_ALLOWLIST_ADDRESS=$NEXT_PUBLIC_USER_ALLOWLIST_ADDRESS \
    NEXT_PUBLIC_USDC_ADDRESS=$NEXT_PUBLIC_USDC_ADDRESS \
    NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=$NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID \
    NEXT_PUBLIC_WS_LIVE_URL=$NEXT_PUBLIC_WS_LIVE_URL
RUN npx nx run web:build

FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000
RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 nextjs
COPY --from=builder /app/apps/web/public ./apps/web/public
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/static ./apps/web/.next/static
USER nextjs
EXPOSE 3000
CMD ["node", "apps/web/server.js"]
