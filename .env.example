# Chain RPC — variable name = chain, value = network for this environment
# local:      ETHEREUM_RPC_URL=http://127.0.0.1:8545  (Hardhat)
# staging:    ETHEREUM_RPC_URL=<sepolia endpoint>
# production: ETHEREUM_RPC_URL=<mainnet endpoint>
CHAIN_ID=31337
ETHEREUM_RPC_URL=http://127.0.0.1:8545
BASE_RPC_URL=https://sepolia.base.org

# Contracts (from property-assets-contracts deployment)
ASSET_VAULT_ADDRESS=
ASSET_SHARES_ADDRESS=
ORACLE_ROUTER_ADDRESS=
USER_ALLOWLIST_ADDRESS=
USDC_ADDRESS=

ADMIN_ADDRESS=
ADMIN_ASSET_MANAGER_ADDRESS= 
ADMIN_COMPLIANCE_ADDRESS=

# WalletConnect
WALLETCONNECT_PROJECT_ID=
APP_URL=https://localhost

# MCP
MCP_PORT=3100

# Live feeds (events ingest + gateway) — display only
REDIS_URL=redis://127.0.0.1:6379
INFURA_PROJECT_ID=
COINBASE_PRODUCT_ID=ETH-USD
TICKER_PUBLISH_INTERVAL_MS=250
GATEWAY_PORT=8081
GATEWAY_WS_PATH=/ws/live
GATEWAY_ALLOWED_ORIGINS=http://localhost:3000
WS_LIVE_URL=ws://localhost:8081/ws/live
