# This environment's JSON-RPC base (Infura hostname selects the chain; INFURA_PROJECT_ID is shared).
# local:      CHAIN_ID=31337     RPC_URL=http://127.0.0.1:8545
# staging:    CHAIN_ID=11155111  RPC_URL=https://sepolia.infura.io/v3/
# production: CHAIN_ID=1         RPC_URL=https://mainnet.infura.io/v3/
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545

# Contracts (from property-assets-contracts deployment)
ASSET_VAULT_ADDRESS=
ASSET_SHARES_ADDRESS=
ORACLE_ROUTER_ADDRESS=
USER_ALLOWLIST_ADDRESS=
USDC_ADDRESS=

ADMIN_ADDRESS=
ADMIN_ASSET_MANAGER_ADDRESS= 
ADMIN_COMPLIANCE_ADDRESS=

# WalletConnect
WALLETCONNECT_PROJECT_ID=
APP_URL=https://localhost

# MCP
MCP_PORT=3100

# Live feeds (events ingest + gateway) — display only
REDIS_URL=redis://127.0.0.1:6379
INFURA_PROJECT_ID=
# Optional: Infura WS network when RPC_URL is a remote non-Infura host (sepolia|mainnet|base|base-sepolia)
INFURA_WS_NETWORK=
# Optional live-network seed allowlist (comma-separated). Defaults to the PRIVATE_KEY account.
SEED_USERS=
COINBASE_PRODUCT_ID=ETH-USD
TICKER_PUBLISH_INTERVAL_MS=250
GATEWAY_PORT=8081
GATEWAY_WS_PATH=/ws/live
GATEWAY_ALLOWED_ORIGINS=http://localhost:3000
WS_LIVE_URL=ws://localhost:8081/ws/live

# Workflows (Temporal — automated build-code from ready-for-agent issues)
REPO_ROOT=/path/to/brickbase
# SKILL_RUNNER controls which agent CLI executes the skill: cursor | claude | codex (default: claude)
SKILL_RUNNER=claude
# Set the key for the chosen runner; the others can be left blank
CURSOR_API_KEY=       # used when SKILL_RUNNER=cursor
ANTHROPIC_API_KEY=    # used when SKILL_RUNNER=claude
OPENAI_API_KEY=       # used when SKILL_RUNNER=codex
