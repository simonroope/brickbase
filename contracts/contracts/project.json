{
  "name": "contracts",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "contracts/contracts",
  "targets": {
    "compile": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "npx hardhat compile",
          "cp artifacts/contracts/core/AssetVault.sol/AssetVault.json abi/src/generated/AssetVault.json",
          "cp artifacts/contracts/core/AssetShares.sol/AssetShares.json abi/src/generated/AssetShares.json",
          "cp artifacts/contracts/periphery/OracleRouter.sol/OracleRouter.json abi/src/generated/OracleRouter.json",
          "cp artifacts/contracts/core/AssetUserAllowList.sol/AssetUserAllowList.json abi/src/generated/AssetUserAllowList.json"
        ],
        "cwd": "contracts",
        "parallel": false
      },
      "configurations": {}
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx hardhat test",
        "cwd": "contracts"
      }
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx hardhat test tests/unit/*.t.ts",
        "cwd": "contracts"
      }
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx hardhat test tests/integration/*.t.ts",
        "cwd": "contracts"
      }
    },
    "test:gas": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx hardhat test tests/gas/*.t.ts",
        "cwd": "contracts"
      }
    },
    "test:security": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx hardhat test tests/security/*.t.ts",
        "cwd": "contracts"
      }
    },
    "test:invariant": {
      "executor": "nx:run-commands",
      "options": {
        "command": "forge test --match-path 'tests/invariant/*.t.sol'",
        "cwd": "contracts"
      }
    },
    "test:upgrade": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx hardhat test tests/upgrade/*.t.ts",
        "cwd": "contracts"
      }
    },
    "forge:build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "forge build",
        "cwd": "contracts"
      }
    },
    "forge:test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "forge test -vvv",
        "cwd": "contracts"
      }
    },
    "forge:test:gas": {
      "executor": "nx:run-commands",
      "options": {
        "command": "forge test --gas-report",
        "cwd": "contracts"
      }
    },
    "forge:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "command": "forge coverage",
        "cwd": "contracts"
      }
    },
    "forge:snapshot": {
      "executor": "nx:run-commands",
      "options": {
        "command": "forge snapshot",
        "cwd": "contracts"
      }
    },
    "node": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx hardhat node",
        "cwd": "contracts"
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "localhost",
      "options": {
        "cwd": "contracts"
      },
      "configurations": {
        "localhost": {
          "command": "npx hardhat run scripts/deploy/deploy.ts --network localhost"
        },
        "sepolia": {
          "command": "npx hardhat run scripts/deploy/deploy.ts --network sepolia"
        },
        "mainnet": {
          "command": "npx hardhat run scripts/deploy/deploy.ts --network mainnet"
        },
        "baseSepolia": {
          "command": "npx hardhat run scripts/deploy/deploy.ts --network baseSepolia"
        },
        "base": {
          "command": "npx hardhat run scripts/deploy/deploy.ts --network base"
        }
      }
    },
    "seed-users": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx hardhat run scripts/seeds/seed-users.ts --network localhost",
        "cwd": "contracts"
      }
    },
    "seed-assets": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx hardhat run scripts/seeds/seed-assets.ts --network localhost",
        "cwd": "contracts"
      }
    }
  },
  "tags": ["scope:contracts"]
}
