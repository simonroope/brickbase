{
  "name": "workflows",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "workflows/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsc",
        "cwd": "workflows"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsx src/worker.ts",
        "cwd": "workflows"
      }
    },
    "trigger": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsx src/client.ts",
        "cwd": "workflows"
      }
    }
  },
  "tags": [
    "scope:workflows"
  ]
}
