{
  "name": "workflows",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "workflows/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsc",
        "cwd": "workflows"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsx workflows/src/worker.ts"
      }
    },
    "trigger": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsx workflows/src/client.ts"
      }
    }
  },
  "tags": [
    "scope:workflows"
  ]
}
